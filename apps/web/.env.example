# Copy to .env and fill in what you use. Every value is optional: without them the app keeps everything on
# the device and sends nothing anywhere.

# Sign-in and sync (Supabase project settings, API keys)
SUPABASE_URL=
SUPABASE_KEY=

# Error reports (Sentry project settings, Client Keys)
SENTRY_DSN=

# Source map upload at build time, so reports show the original code (an organization auth token; the project's
# slug or ID). Leave the token empty to build without uploading
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Product analytics (PostHog project settings); the host defaults to PostHog's US cloud
POSTHOG_KEY=
POSTHOG_HOST=
